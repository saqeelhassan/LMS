APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set to your app URL. If the app is in a subdirectory (e.g. http://localhost/LMS-Digi-Sindh/public), set this and uncomment RewriteBase in public/.htaccess so /lms works.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# DSIMT admission forms (public/dsimt/Admission_Form/) – do not commit real credentials
# DB_DSIMT_HOST=127.0.0.1
# DB_DSIMT_PORT=3306
# DB_DSIMT_DATABASE=dsimtedu_DSIMTDB
# DB_DSIMT_USERNAME=
# DB_DSIMT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Super Admin (single login; created by seeder only, not from panel)
# SUPERADMIN_EMAIL=superadmin@example.com
# SUPERADMIN_PASSWORD=password

# Biometric punch API (ZKTeco/Hikvision devices)
# Generate token: php artisan tinker → Str::random(64)
# BIOMETRIC_API_TOKEN=
# Optional: comma-separated device IDs to allowlist (blank = allow all)
# BIOMETRIC_DEVICE_IDS=DEVICE001,GATE-A
# BIOMETRIC_OFFICE_START=09:00
# BIOMETRIC_LATE_AFTER_MINUTES=15
# BIOMETRIC_SHORT_ATTENDANCE_MINUTES=10

# ZKTeco uFace 800 pull (IP:4370) – for Sync Now with uFace 800 and biometric:pull-zkteco
# ZKTECO_IP=192.168.1.201
# ZKTECO_PORT=4370
# ZKTECO_DEVICE_ID=uface800-1
